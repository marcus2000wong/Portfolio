{
  // wrangler.jsonc
  "name": "portfolio",
  "main": "./worker.ts",
  "compatibility_date": "2026-08-21",
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  }
}
